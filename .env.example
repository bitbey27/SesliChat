# Render / lokal ortam için gerekli environment variables
# Lokalde: .env dosyasına kopyalayın. Production'da Render Dashboard → Environment'tan ekleyin.

# Admin şifresi (chat kutusundan /admin <şifre> ile giriş için)
# Boş bırakılırsa varsayılan 'admin123' kullanılır (GÜVENLİK RİSKİ — production'da mutlaka değiştirin)
ADMIN_PASSWORD=admin123_yerine_guclu_bir_sifre_koyun

# Node ortamı
NODE_ENV=production

# Sunucu portu (Render otomatik verir, lokalde 3000 varsayılan)
PORT=3000
